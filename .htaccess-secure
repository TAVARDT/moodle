# ----------------------------------------------------------------------
# TAVARDT Elite Moodle Security Rules
# ----------------------------------------------------------------------

# 1. Disable Directory Listing
Options -Indexes

# 2. Block direct access to sensitive configuration files
<FilesMatch "^.*(error_log|config\.php|php.ini|\.[hH][tT][aApP].*)$">
    Order deny,allow
    Deny from all
</FilesMatch>

# 3. Block access to hidden directories (.git, .env, etc)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(.*/)?\.git/ - [F,L]
RewriteRule ^(.*/)?\.env - [F,L]
</IfModule>

# 4. Protect moodledata if accidentally placed in web root
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^moodledata/ - [F,L]
</IfModule>

# 5. Block access to log and cache files generated by plugins
<FilesMatch "\.(log|txt|md|sh)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

